# Python
__pycache__/
*.pyc
.venv/

# Legacy GTFS mock files from an earlier prototype (unused by the app)
data/calendar.txt
data/routes.txt
data/stop_times.txt
data/stops.txt
data/trips.txt

# Reference documents
*.pdf

# Raw HTML/PDF cache from UCT scraper (large, regenerated by ETL)
data/uct_raw/

# Built database: rebuilt from data/snapshot/*.parquet on first start, or by
# run_etl.py. Commit the snapshot, never the .duckdb (a committed copy would
# be served instead of a fresher snapshot).
data/*.duckdb
data/*.duckdb.wal

# Local tool state
.claude/settings.local.json
.claude/*
.DS_Store

# Local tool lock files
.claude/scheduled_tasks.lock
